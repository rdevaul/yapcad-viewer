{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yapcad.org/schemas/viewer/session-v1.schema.json",
  "title": "yapcad-viewer session snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sessionId",
    "revision",
    "package",
    "components",
    "parts",
    "mates",
    "joints",
    "bom",
    "materials",
    "selection",
    "validation"
  ],
  "properties": {
    "schema": {"const": "yapcad-viewer-session-v1"},
    "sessionId": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 0},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rootPartId": {"type": ["string", "null"]}
      }
    },
    "parts": {
      "type": "array",
      "items": {"$ref": "#/$defs/part"}
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    },
    "mates": {
      "type": "array",
      "items": {"$ref": "#/$defs/mate"}
    },
    "joints": {
      "type": "array",
      "items": {"$ref": "#/$defs/joint"}
    },
    "bom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/bomItem"}}
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "selection": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors", "warnings"],
      "properties": {
        "valid": {"type": "boolean"},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    }
  },
  "$defs": {
    "matrix4": {
      "description": "Column-major homogeneous 4x4 transform",
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"type": "number"}
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "componentId", "transform", "datums", "visible"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "componentId": {"type": "string", "minLength": 1},
        "parentId": {"type": ["string", "null"]},
        "materialId": {"type": ["string", "null"]},
        "assetDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "transform": {"$ref": "#/$defs/matrix4"},
        "datums": {"type": "array", "items": {"$ref": "#/$defs/datum"}},
        "visible": {"type": "boolean"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "disposition", "quantityPerInstance", "unit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "disposition": {"enum": ["make", "buy", "raw_stock", "consumable"]},
        "quantityPerInstance": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "partNumber": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "materialId": {"type": ["string", "null"]},
        "manufacturing": {"type": ["object", "null"]},
        "procurement": {"type": ["object", "null"]},
        "pmi": {"type": ["object", "null"]},
        "assetDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "datum": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "origin"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "origin": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
      }
    },
    "mate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "partA", "datumA", "partB", "datumB"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "partA": {"type": "string", "minLength": 1},
        "datumA": {"type": "string", "minLength": 1},
        "partB": {"type": "string", "minLength": 1},
        "datumB": {"type": "string", "minLength": 1},
        "offset": {"type": "number"},
        "angle": {"type": "number"},
        "limits": {"type": ["object", "null"]}
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value", "unit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"enum": ["radian", "millimetre"]},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]}
      }
    },
    "bomItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "componentId", "description", "disposition", "quantity", "unit"],
      "properties": {
        "item": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string", "minLength": 1},
        "partNumber": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "description": {"type": "string"},
        "disposition": {"enum": ["make", "buy", "raw_stock", "consumable"]},
        "quantity": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "entityIds": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
